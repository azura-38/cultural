# Qwen / DashScope API settings
# Use one of these API key variable names. DASHSCOPE_API_KEY is preferred.
DASHSCOPE_API_KEY=your_qwen_dashscope_api_key_here
# QWEN_API_KEY=your_qwen_dashscope_api_key_here

# Defaults are safe to keep unless your Qwen provider gave you another endpoint/model.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
